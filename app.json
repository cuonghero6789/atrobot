{
  "expo": {
    "name": "AstroBot",
    "slug": "astrobot",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "astrobot",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "ios": {
      "usesAppleSignIn": true,
      "runtimeVersion": "1.0.1",
      "supportsTablet": true,
      "bundleIdentifier": "com.gbv.astrobot",
      "googleServicesFile": "ios/AstroBot/GoogleService-Info.plist",
      "teamId": "YP79F7ANUK",
      "infoPlist": {
        "NSCameraUsageDescription": "We need access to your camera to take photos for your profile and share moments with others.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIStatusBarStyle": "UIStatusBarStyleLightContent"
      },
      "buildConfiguration": "Release",
      "hermes": true,
      "appleTeamId": "YP79F7ANUK"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.gbv.astrobot",
      "versionCode": 2,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "hermes": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-system-ui",
        {
          "rootViewBackgroundColor": "#ffffff"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "ndkVersion": "26.1.10909125",
            "enableProguardInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false,
            "enablePngCrunchInReleaseBuilds": true,
            "useLegacyPackaging": false,
            "useAndroidX": true,
            "newArchEnabled": true,
            "hermesEnabled": true,
            "reactNativeArchitectures": [
              "armeabi-v7a",
              "arm64-v8a",
              "x86",
              "x86_64"
            ],
            "packagingOptions": {
              "pickFirsts": [],
              "excludes": [],
              "merges": [],
              "doNotStrip": []
            },
            "proguardFiles": [
              "proguard-rules.pro"
            ]
          },
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "15.1",
            "enableBitcode": false,
            "buildConfiguration": "Release",
            "enableHermes": true,
            "generateDsym": true
          }
        }
      ],
      [
        "@react-native-firebase/app"
      ],
      [
        "@react-native-google-signin/google-signin"
      ],
      [
        "react-native-fbsdk-next",
        {
          "appID": "1802586003796873",
          "clientToken": "9f40b7b535cfc0cec350f9e358299bd7",
          "displayName": "AtroBot",
          "scheme": "fb1802586003796873",
          "advertiserIDCollectionEnabled": false,
          "autoLogAppEventsEnabled": false,
          "isAutoInitEnabled": true
        }
      ],
      "expo-localization",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to access your location to support app features. Your location is never shared."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "$(PRODUCT_NAME) needs access to your camera to take photos. Your content stays private and is not shared."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to upload and display them in the app. Your content remains private.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "$(PRODUCT_NAME) needs access to your camera to take photos.",
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to upload and display them in the app.",
          "microphonePermission": "$(PRODUCT_NAME) needs access to your microphone when recording videos."
        }
      ],
      "expo-apple-authentication",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Montserrat-Medium.ttf",
            "./assets/fonts/Montserrat-Regular.ttf",
            "./assets/fonts/Montserrat-SemiBold.ttf",
            "./assets/fonts/Montserrat-Bold.ttf"
          ]
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-8326859693302166~3956894287"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "5788c1d0-2c97-487a-96eb-82a4a2c32cf5"
      }
    },
    "owner": "phancuong6789",
    "react-native-google-mobile-ads": {
      "android_app_id": "ca-app-pub-8326859693302166~3956894287"
    },
    "runtimeVersion": "1.0.1",
    "updates": {
      "url": "https://u.expo.dev/5788c1d0-2c97-487a-96eb-82a4a2c32cf5"
    },
    "androidStatusBar": {
      "backgroundColor": "#ffffff",
      "barStyle": "dark-content"
    }
  }
}
